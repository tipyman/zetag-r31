<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="`ZVv3B7@#sMV}L:PEmhG" x="20" y="20"><statement name="HANDLER"><block type="typescript_statement" id="K1kpy^}o7Vs%:t_7*@uW"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace ZETag_R31 {" line1="" line2="    // -----------------------------" line3="    // Constants &amp; Types" line4="    // -----------------------------" line5="" line6="    const txBuffer = pins.createBuffer(1);" line7="" line8="    // Frame types" line9="    const CMD_MAC = 0x01;" line10="    const CMD_VERSION = 0x02;" line11="    const CMD_SET_TX_MODE = 0x40; // 周波数/チャネル構成" line12="    const CMD_TX_POWER = 0x41; // 送信電力" line13="    const CMD_RADIO_PARAM = 0x42; // 無線パラメータ（変調・SR・CR）" line14="    const CMD_OP_MODE = 0x44; // 動作モード（透過/テスト）" line15="    const CMD_CH_SPACE_SET = 0xF0; // チャネル間隔（設定）" line16="    const CMD_CH_SPACE_QRY = 0xF1; // チャネル間隔（応答/クエリ）" line17="    const CMD_APP_DATA = 0x80; // アプリデータ送信" line18="    const CMD_ERROR = 0xFF; // エラーフィードバック" line19="" line20="    // Sub mode for CMD_SET_TX_MODE (0x40)" line21="    const SUB_SINGLE = 0x00; // 1ch（短縮）" line22="    const SUB_MULTI = 0x01; // 2ch以上（汎用）" line23="" line24="    // Rx status" line25="    export enum RxStatus {" line26="        OK = 0xFF, // 正常応答" line27="        TIMEOUT = 1,    // 受信タイムアウト" line28="        SIZE_ERR = 2,    // サイズ不一致" line29="        ZETAG_ERR = 3,    // ZETag側エラー(TYPE=0xFF)" line30="        CHECKSUM_ERR = 4,    // チェックサム不一致/Type突合不一致" line31="        FORMAT_ERR = 5     // フォーマット不正" line32="    }" line33="" line34="    // --- UI enums ---" line35="    export enum ChSpace {" line36="        //% block=&quot;100&quot;" line37="        KHz100 = 100," line38="        //% block=&quot;200&quot;" line39="        KHz200 = 200" line40="    }" line41="    export enum ChNum {" line42="        //% block=&quot;1&quot;" line43="        _1 = 1," line44="        //% block=&quot;2&quot;" line45="        _2 = 2," line46="        //% block=&quot;3&quot;" line47="        _3 = 3," line48="        //% block=&quot;4&quot;" line49="        _4 = 4," line50="        //% block=&quot;5&quot;" line51="        _5 = 5," line52="        //% block=&quot;6&quot;" line53="        _6 = 6," line54="    }" line55="    export enum TxPower {" line56="        //% block=&quot;2&quot;" line57="        dBm2 = 2," line58="        //% block=&quot;4&quot;" line59="        dBm4 = 4," line60="        //% block=&quot;6&quot;" line61="        dBm6 = 6," line62="        //% block=&quot;8&quot;" line63="        dBm8 = 8," line64="        //% block=&quot;10&quot;" line65="        dBm10 = 10," line66="    }" line67="    export enum Mode {" line68="        //% block=&quot;4FSK&quot;" line69="        FSK4 = 0," line70="        //% block=&quot;8FSK&quot;" line71="        FSK8 = 1" line72="    }" line73="    export enum OP_Mode {" line74="        //% block=&quot;Normal&quot;" line75="        Normal = 0," line76="        //% block=&quot;Test&quot;" line77="        Test = 1" line78="    }" line79="" line80="    // -----------------------------" line81="    // Low-level helpers" line82="    // -----------------------------" line83="" line84="    /** TX one byte (0..255) */" line85="    function UART_BIN_TX(txData: number): void {" line86="        txBuffer.setUint8(0, txData &amp; 0xFF);" line87="        serial.writeBuffer(txBuffer);" line88="    }" line89="" line90="    /** RX one byte (blocking); returns 0..255 */" line91="    function UART_BIN_RX(): number {" line92="        const rxBuffer = serial.readBuffer(1); // blocking" line93="        if (rxBuffer.length &gt; 0) return rxBuffer[0] &amp; 0xFF;" line94="        return 0;" line95="    }" line96="" line97="    /** Sum of bytes (8-bit) */" line98="    function checksum8(bytes: number[]): number {" line99="        let sum = 0;" line100="        for (let i = 0; i &lt; bytes.length; i++) sum = sum + bytes[i];" line101="        return sum &amp; 0xFF;" line102="    }" line103="" line104="    /**" line105="     * Receive: FF 00 LEN [Type..(LEN-1 bytes)] CRC" line106="     * 戻り: [status(=0xFF), 0x00, LEN, Type, ..., CRC] or [RxStatus.*]" line107="     */" line108="    function receive_query(): number[] {" line109="        let timeoutCounter = 0;" line110="" line111="        // sync FF" line112="        while (true) {" line113="            const d = UART_BIN_RX();" line114="            if (d === 0xFF) break;" line115="            if (++timeoutCounter &gt; 250) return [RxStatus.TIMEOUT];" line116="        }" line117="" line118="        // expect 00" line119="        const b1 = UART_BIN_RX();" line120="        if (b1 !== 0x00) return [RxStatus.FORMAT_ERR];" line121="" line122="        // read LEN" line123="        const len = UART_BIN_RX();" line124="        if (len &lt; 2) return [RxStatus.FORMAT_ERR]; // 最小: Type(1)+CRC(1)" line125="" line126="        // read (LEN-1) bytes (Type + Data...)" line127="        const typeAndData: number[] = [];" line128="        for (let j = 0; j &lt; len - 1; j++) typeAndData.push(UART_BIN_RX());" line129="" line130="        // read CRC" line131="        const crc = UART_BIN_RX();" line132="" line133="        // verify checksum" line134="        const calc = checksum8([0xFF, 0x00, len].concat(typeAndData));" line135="        if (calc !== crc) return [RxStatus.CHECKSUM_ERR];" line136="" line137="        // OK" line138="        return [RxStatus.OK, 0x00, len].concat(typeAndData).concat([crc]);" line139="    }" line140="" line141="    /**" line142="     * sendCommand: [FF,00,LEN, Type, ...payload..., CRC]" line143="     * LEN = 1(Type) + payload.length + 1(CRC)" line144="     */" line145="" line146="    function sendCommand(type: number, payload: number[] = []): number[] {" line147="        const len2 = 2 + payload.length;" line148="        const header = [0xFF, 0x00, len2, type];" line149="        const crc2 = checksum8(header.concat(payload));" line150="" line151="        const frame = header.concat(payload);" line152="        frame.push(crc2); // ← ここがポイント" line153="" line154="        for (let k = 0; k &lt; frame.length; k++) UART_BIN_TX(frame[k]);" line155="        basic.pause(20) //260701 AC給電の場合、これが効く。受信までちょっと待つ。" line156="" line157="        return receive_query();" line158="    }" line159="" line160="    // -----------------------------" line161="    // Public APIs" line162="    // -----------------------------" line163="" line164="    /**" line165="     * 完成済みフレームをそのまま送信→受信" line166="     * queryData[0] = RxStatus" line167="     */" line168="    //% blockId=Send_ZETag_command block=&quot;Send ZETag command %txArray&quot;" line169="    //% group=&quot;Send data&quot; weight=95 blockGap=8" line170="    export function Send_ZETag_command(txArray: number[]): number[] {" line171="        for (let l = 0; l &lt; txArray.length; l++) UART_BIN_TX(txArray[l] &amp; 0xFF);" line172="        basic.pause(20) //260701 AC給電の場合、これが効く。受信までちょっと待つ。" line173="" line174="        const rsp = receive_query();" line175="        if (rsp[0] !== RxStatus.OK) return rsp;" line176="" line177="        const reqType = txArray[3] &amp; 0xFF;" line178="        const rspType = rsp[3] &amp; 0xFF;" line179="" line180="        // 例外: F0(設定)→F1(応答)を許容" line181="        const okType =" line182="            (rspType === reqType) ||" line183="            (reqType === CMD_CH_SPACE_SET &amp;&amp; rspType === CMD_CH_SPACE_QRY);" line184="" line185="        // エラーフレーム TYPE=0xFF" line186="        if (rspType === CMD_ERROR) {" line187="            rsp[0] = RxStatus.ZETAG_ERR;" line188="            return rsp;" line189="        }" line190="" line191="        if (!okType) rsp[0] = RxStatus.CHECKSUM_ERR;" line192="        return rsp;" line193="    }" line194="" line195="    /**" line196="     * アプリケーションデータ送信 (0x80), N&lt;=30" line197="     */" line198="    //% blockId=Transmit_ZETag_data block=&quot;Transmit ZETag data %dataArray&quot;" line199="    //% group=&quot;Send data&quot; weight=95 blockGap=8" line200="    export function Transmit_ZETag_data(txArray: number[]): void {" line201="        if (!txArray || txArray.length &lt; 1) return;" line202="        let n = txArray.length;" line203="        if (n &gt; 30) n = 30; // 仕様上限" line204="" line205="        const payload = txArray.slice(0, n);" line206="        const rsp2 = sendCommand(CMD_APP_DATA, payload);" line207="        // 応答は 0x80 0x81（成功） or 0xFF（エラー）" line208="    }" line209="" line210="    /**" line211="     * バージョン取得 (0x02)" line212="     * 戻り: 上位4bit=メイン、下位4bit=サブ" line213="     */" line214="    //% blockId=Get_Protocol_Version block=&quot;Get Protocol Version&quot;" line215="    //% subcategory=&quot;Other&quot; weight=95 blockGap=8" line216="    export function Get_Protocol_Version(): number {" line217="        const rsp3 = sendCommand(CMD_VERSION, []); // payloadなし" line218="        if (rsp3[0] !== RxStatus.OK) return 0;" line219="" line220="        const main = rsp3[4] &amp; 0x0F;" line221="        const sub = rsp3[5] &amp; 0x0F;" line222="        return ((main &lt;&lt; 4) | sub) &amp; 0xFF;" line223="    }" line224="" line225="    /**" line226="     * 動作モード設定 (0x44)" line227="     * Normal: FF 00 03 44 00 46" line228="     * Test  : FF 00 05 44 01 [periodHi] [periodLo] CRC" line229="     */" line230="    //% blockId=Set_Operating_Mode block=&quot;Set Operating Mode %mode&quot;" line231="    //% subcategory=&quot;Other&quot; weight=95 blockGap=8" line232="    //% mode.min=0 mode.max=1 mode.defl=0" line233="    export function Set_Operating_Mode(mode: OP_Mode): void {" line234="        if (mode === OP_Mode.Test) {" line235="            // 既定周期1秒：別ブロック setTestMode() で任意指定可" line236="            sendCommand(CMD_OP_MODE, [0x01, 0x00, 0x01]);" line237="        } else {" line238="            // 透過（パススルー）" line239="            sendCommand(CMD_OP_MODE, [0x00]);" line240="        }" line241="    }" line242="" line243="    /**" line244="     * 送信電力設定 (0x41)" line245="     * 0.5dB/step, 0x10=8dBm, 0x14=10dBm" line246="     */" line247="    //% blockId=Set_TX_Power block=&quot;Set TX Power %txPower (dB)&quot;" line248="    //% subcategory=&quot;Other&quot; weight=95 blockGap=8" line249="    //% txPower.min=1 txPower.max=10 txPower.defl=10" line250="    export function Set_TX_Power(txPower: number): void {" line251="        if (txPower &lt; 1) txPower = 1;" line252="        if (txPower &gt; 10) txPower = 10;" line253="        const reg = (txPower * 2) &amp; 0xFF;" line254="        sendCommand(CMD_TX_POWER, [reg]);" line255="    }" line256="" line257="    /**" line258="     * チャネル間隔設定 (0xF0), 応答は 0xF1" line259="     */" line260="    //% blockId=Set_channel_spacing block=&quot;Set channel spacing %chSpace (kHz)&quot;" line261="    //% subcategory=&quot;Other&quot; weight=95 blockGap=8" line262="    //% chSpace.min=100 chSpace.max=200 chSpace.defl=100" line263="    export function Set_channel_spacing(chSpace: number): void {" line264="        if (chSpace &lt; 100) chSpace = 100;" line265="        if (chSpace &gt; 200) chSpace = 200;" line266="        sendCommand(CMD_CH_SPACE_SET, [chSpace &amp; 0xFF]);" line267="    }" line268="" line269="    /**" line270="     * 周波数設定 (0x40)" line271="     * 1ch:   0x40 0x00 [Freq4B]" line272="     * 2..6ch:0x40 0x01 [Freq4B] [chNum] [channelNumbers...]" line273="     */" line274="    //% blockId=Set_Frequency block=&quot;Set Frequency %frequency (Hz) %chNum (ch) %chStep&quot;" line275="    //% subcategory=&quot;Other&quot; weight=95 blockGap=8" line276="    //% frequency.min=470000000 frequency.max=928000000 frequency.defl=922080000" line277="    //% chNum.min=1 chNum.max=6 chNum.defl=2" line278="    //% chStep.min=1 chStep.max=2 chStep.defl=2" line279="    export function Set_Frequency(frequency: number, chNum: number, chStep: number): void {" line280="        // clip" line281="        if (chNum &lt; 1) chNum = 1;" line282="        if (chNum &gt; 6) chNum = 6;" line283="        if (chStep &lt; 1) chStep = 1;" line284="        if (chStep &gt; 2) chStep = 2;" line285="" line286="        // region clip（運用帯: 470–510MHz / 920–928MHz）" line287="        if (frequency &lt; 470000000) frequency = 470000000;" line288="        else if (frequency &gt; 928000000) frequency = 928000000;" line289="        else if ((frequency &gt; 510000000) &amp;&amp; (frequency &lt; 920600000)) frequency = 510000000;" line290="" line291="        const f3 = (frequency &gt;&gt;&gt; 24) &amp; 0xFF;" line292="        const f2 = (frequency &gt;&gt;&gt; 16) &amp; 0xFF;" line293="        const f1 = (frequency &gt;&gt;&gt; 8) &amp; 0xFF;" line294="        const f0 = (frequency) &amp; 0xFF;" line295="" line296="        if (chNum === 1) {" line297="            // single channel (short)" line298="            const payload2 = [SUB_SINGLE, f3, f2, f1, f0];" line299="            sendCommand(CMD_SET_TX_MODE, payload2);" line300="        } else {" line301="            // multi channel" line302="            const payload3: number[] = [SUB_MULTI, f3, f2, f1, f0, chNum];" line303="            for (let o = 0; o &lt; chNum; o++) payload3.push((o * chStep) &amp; 0xFF);" line304="            sendCommand(CMD_SET_TX_MODE, payload3);" line305="        }" line306="    }" line307="" line308="    /**" line309="     * 無線パラメータ設定 (0x42)" line310="     * 仕様上 0x01=4FSK+600sps+1/2 のみ明記。FSK8 は予約。" line311="     */" line312="    //% blockId=Set_TX_Mode block=&quot;Set TX Mode %txMode&quot;" line313="    //% subcategory=&quot;Other&quot; weight=95 blockGap=8" line314="    //% txMode.defl=Mode.FSK4" line315="    export function Set_TX_Mode(txMode: Mode): void {" line316="        if (txMode === Mode.FSK4)" line317="            sendCommand(CMD_RADIO_PARAM, [0x01]);&#9;//4FSK" line318="        else" line319="            sendCommand(CMD_RADIO_PARAM, [0x10]);&#9;//8FSK" line320="    }" line321="" line322="    // --- まとめ設定ブロック ---" line323="    /**" line324="     * ZETag の無線設定一括適用" line325="     */" line326="    //% blockId=zetag_setting" line327="    //% block=&quot;ZETag Setting|Frequency(Hz) %frequency|Band width(kHz) %chSpace|Number of Channel(ch) %chNum|Tx Power(dB) %txPower|Mode %mode&quot;" line328="    //% group=&quot;ZETag Setting&quot; weight=95 blockGap=8" line329="    //% frequency.min=470000000 frequency.max=928000000 frequency.defl=922080000" line330="    //% chSpace.min=100 chSpace.max=200 chSpace.defl=200" line331="    //% chNum.min=1 chNum.max=6 chNum.defl=2" line332="    //% txPower.min=2 txPower.max=10 txPower.defl=8" line333="    //% mode.defl=Mode.FSK4" line334="    export function applySetting(" line335="        frequency: number," line336="        chSpace: ChSpace," line337="        chNum: ChNum," line338="        txPower: TxPower," line339="        mode: Mode" line340="    ): void {" line341="        // 0) 無線パラメータ（変調等）" line342="        Set_TX_Mode(mode);" line343="" line344="        // 1) チャネル間隔（例: 作法として 100kHz に固定）" line345="        Set_channel_spacing(ChSpace.KHz100);" line346="" line347="        // 2) 周波数＋チャネル" line348="        const chStep = (chSpace === ChSpace.KHz200) ? 2 : 1;" line349="        Set_Frequency(frequency, chNum, chStep);" line350="" line351="        // 3) 送信電力" line352="        Set_TX_Power(txPower);" line353="    }" line354="}" numlines="355"></mutation></block></statement></block></xml>