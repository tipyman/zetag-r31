<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="!BJxmJg[7}5}?s=Q60a$" x="20" y="20"><statement name="HANDLER"><block type="typescript_statement" id="l75)fXI1O;dsAQQ=O_,e"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace ZETag_R31 {" line1="    " line2="    // -----------------------------" line3="    // Constants &amp; Types" line4="    // -----------------------------" line5="" line6="    const txBuffer = pins.createBuffer(1);" line7="" line8="    // Frame types" line9="    const CMD_MAC = 0x01;" line10="    const CMD_VERSION = 0x02;" line11="    const CMD_SET_TX_MODE = 0x40; // 周波数/チャネル構成" line12="    const CMD_TX_POWER = 0x41; // 送信電力" line13="    const CMD_RADIO_PARAM = 0x42; // 無線パラメータ（変調・SR・CR）" line14="    const CMD_OP_MODE = 0x44; // 動作モード（透過/テスト）" line15="    const CMD_CH_SPACE_SET = 0xF0; // チャネル間隔（設定）" line16="    const CMD_CH_SPACE_QRY = 0xF1; // チャネル間隔（応答/クエリ）" line17="    const CMD_APP_DATA = 0x80; // アプリデータ送信" line18="    const CMD_ERROR = 0xFF; // エラーフィードバック" line19="" line20="    // Sub mode for CMD_SET_TX_MODE (0x40)" line21="    const SUB_SINGLE = 0x00; // 1ch（短縮）" line22="    const SUB_MULTI = 0x01; // 2ch以上（汎用）" line23="" line24="    // Rx status" line25="    export enum RxStatus {" line26="        OK = 0xFF, // 正常応答" line27="        TIMEOUT = 1,    // 受信タイムアウト" line28="        SIZE_ERR = 2,    // サイズ不一致" line29="        ZETAG_ERR = 3,    // ZETag側エラー(TYPE=0xFF)" line30="        CHECKSUM_ERR = 4,    // チェックサム不一致/Type突合不一致" line31="        FORMAT_ERR = 5     // フォーマット不正" line32="    }" line33="" line34="    // --- UI enums ---" line35="    export enum ChSpace {" line36="        //% block=&quot;100&quot;" line37="        KHz100 = 100," line38="        //% block=&quot;200&quot;" line39="        KHz200 = 200" line40="    }" line41="    export enum ChNum {" line42="        //% block=&quot;1&quot;" line43="        _1 = 1," line44="        //% block=&quot;2&quot;" line45="        _2 = 2," line46="        //% block=&quot;3&quot;" line47="        _3 = 3," line48="        //% block=&quot;4&quot;" line49="        _4 = 4," line50="        //% block=&quot;5&quot;" line51="        _5 = 5," line52="        //% block=&quot;6&quot;" line53="        _6 = 6," line54="    }" line55="    export enum TxPower {" line56="        //% block=&quot;2&quot;" line57="        dBm2 = 2," line58="        //% block=&quot;4&quot;" line59="        dBm4 = 4," line60="        //% block=&quot;6&quot;" line61="        dBm6 = 6," line62="        //% block=&quot;8&quot;" line63="        dBm8 = 8," line64="        //% block=&quot;10&quot;" line65="        dBm10 = 10," line66="    }" line67="    export enum Mode {" line68="        //% block=&quot;4FSK&quot;" line69="        FSK4 = 0," line70="        //% block=&quot;8FSK&quot;" line71="        FSK8 = 1" line72="    }" line73="    export enum OP_Mode {" line74="        //% block=&quot;Normal&quot;" line75="        Normal = 0," line76="        //% block=&quot;Test&quot;" line77="        Test = 1" line78="    }" line79="" line80="    // -----------------------------" line81="    // Low-level helpers" line82="    // -----------------------------" line83="" line84="    /** TX one byte (0..255) */" line85="    function UART_BIN_TX(txData: number): void {" line86="        txBuffer.setUint8(0, txData &amp; 0xFF);" line87="        serial.writeBuffer(txBuffer);" line88="    }" line89="" line90="    /** RX one byte (blocking); returns 0..255 */" line91="    function UART_BIN_RX(): number {" line92="        const rxBuffer = serial.readBuffer(1); // blocking" line93="        if (rxBuffer.length &gt; 0) return rxBuffer[0] &amp; 0xFF;" line94="        return 0;" line95="    }" line96="" line97="    /** Sum of bytes (8-bit) */" line98="    function checksum8(bytes: number[]): number {" line99="        let sum = 0;" line100="        for (let i = 0; i &lt; bytes.length; i++) sum = sum + bytes[i];" line101="        return sum &amp; 0xFF;" line102="    }" line103="" line104="    /**" line105="     * Receive: FF 00 LEN [Type..(LEN-1 bytes)] CRC" line106="     * 戻り: [status(=0xFF), 0x00, LEN, Type, ..., CRC] or [RxStatus.*]" line107="     */" line108="    function receive_query(): number[] {" line109="        let timeoutCounter = 0;" line110="" line111="        // sync FF" line112="        while (true) {" line113="            const d = UART_BIN_RX();" line114="            if (d === 0xFF) break;" line115="            if (++timeoutCounter &gt; 250) return [RxStatus.TIMEOUT];" line116="        }" line117="" line118="        // expect 00" line119="        const b1 = UART_BIN_RX();" line120="        if (b1 !== 0x00) return [RxStatus.FORMAT_ERR];" line121="" line122="        // read LEN" line123="        const len = UART_BIN_RX();" line124="        if (len &lt; 2) return [RxStatus.FORMAT_ERR]; // 最小: Type(1)+CRC(1)" line125="" line126="        // read (LEN-1) bytes (Type + Data...)" line127="        const typeAndData: number[] = [];" line128="        for (let j = 0; j &lt; len - 1; j++) typeAndData.push(UART_BIN_RX());" line129="" line130="        // read CRC" line131="        const crc = UART_BIN_RX();" line132="" line133="        // verify checksum" line134="        const calc = checksum8([0xFF, 0x00, len].concat(typeAndData));" line135="        if (calc !== crc) return [RxStatus.CHECKSUM_ERR];" line136="" line137="        // OK" line138="        return [RxStatus.OK, 0x00, len].concat(typeAndData).concat([crc]);" line139="    }" line140="" line141="    /**" line142="     * sendCommand: [FF,00,LEN, Type, ...payload..., CRC]" line143="     * LEN = 1(Type) + payload.length + 1(CRC)" line144="     */" line145="" line146="    function sendCommand(type: number, payload: number[] = []): number[] {" line147="        const len2 = 2 + payload.length;" line148="        const header = [0xFF, 0x00, len2, type];" line149="        const crc2 = checksum8(header.concat(payload));" line150="" line151="        const frame = header.concat(payload);" line152="        frame.push(crc2); // ← ここがポイント" line153="" line154="        for (let k = 0; k &lt; frame.length; k++) UART_BIN_TX(frame[k]);" line155="" line156="        return receive_query();" line157="    }" line158="" line159="    // -----------------------------" line160="    // Public APIs" line161="    // -----------------------------" line162="" line163="    /**" line164="     * 完成済みフレームをそのまま送信→受信" line165="     * queryData[0] = RxStatus" line166="     */" line167="    //% blockId=Send_ZETag_command block=&quot;Send ZETag command %txArray&quot;" line168="    //% group=&quot;Send data&quot; weight=95 blockGap=8" line169="    export function Send_ZETag_command(txArray: number[]): number[] {" line170="        for (let l = 0; l &lt; txArray.length; l++) UART_BIN_TX(txArray[l] &amp; 0xFF);" line171="" line172="        const rsp = receive_query();" line173="        if (rsp[0] !== RxStatus.OK) return rsp;" line174="" line175="        const reqType = txArray[3] &amp; 0xFF;" line176="        const rspType = rsp[3] &amp; 0xFF;" line177="" line178="        // 例外: F0(設定)→F1(応答)を許容" line179="        const okType =" line180="            (rspType === reqType) ||" line181="            (reqType === CMD_CH_SPACE_SET &amp;&amp; rspType === CMD_CH_SPACE_QRY);" line182="" line183="        // エラーフレーム TYPE=0xFF" line184="        if (rspType === CMD_ERROR) {" line185="            rsp[0] = RxStatus.ZETAG_ERR;" line186="            return rsp;" line187="        }" line188="" line189="        if (!okType) rsp[0] = RxStatus.CHECKSUM_ERR;" line190="        return rsp;" line191="    }" line192="" line193="    /**" line194="     * アプリケーションデータ送信 (0x80), N&lt;=30" line195="     */" line196="    //% blockId=Transmit_ZETag_data block=&quot;Transmit ZETag data %dataArray&quot;" line197="    //% group=&quot;Send data&quot; weight=95 blockGap=8" line198="    export function Transmit_ZETag_data(txArray: number[]): void {" line199="        if (!txArray || txArray.length &lt; 1) return;" line200="        let n = txArray.length;" line201="        if (n &gt; 30) n = 30; // 仕様上限" line202="" line203="        const payload = txArray.slice(0, n);" line204="        const rsp2 = sendCommand(CMD_APP_DATA, payload);" line205="        // 応答は 0x80 0x81（成功） or 0xFF（エラー）" line206="    }" line207="" line208="    /**" line209="     * バージョン取得 (0x02)" line210="     * 戻り: 上位4bit=メイン、下位4bit=サブ" line211="     */" line212="    //% blockId=Get_Protocol_Version block=&quot;Get Protocol Version&quot;" line213="    //% subcategory=&quot;Other&quot; weight=95 blockGap=8" line214="    export function Get_Protocol_Version(): number {" line215="        const rsp3 = sendCommand(CMD_VERSION, []); // payloadなし" line216="        if (rsp3[0] !== RxStatus.OK) return 0;" line217="" line218="        const main = rsp3[4] &amp; 0x0F;" line219="        const sub = rsp3[5] &amp; 0x0F;" line220="        return ((main &lt;&lt; 4) | sub) &amp; 0xFF;" line221="    }" line222="" line223="    /**" line224="     * 動作モード設定 (0x44)" line225="     * Normal: FF 00 03 44 00 46" line226="     * Test  : FF 00 05 44 01 [periodHi] [periodLo] CRC" line227="     */" line228="    //% blockId=Set_Operating_Mode block=&quot;Set Operating Mode %mode&quot;" line229="    //% subcategory=&quot;Other&quot; weight=95 blockGap=8" line230="    //% mode.min=0 mode.max=1 mode.defl=0" line231="    export function Set_Operating_Mode(mode: OP_Mode): void {" line232="        if (mode === OP_Mode.Test) {" line233="            // 既定周期1秒：別ブロック setTestMode() で任意指定可" line234="            sendCommand(CMD_OP_MODE, [0x01, 0x00, 0x01]);" line235="        } else {" line236="            // 透過（パススルー）" line237="            sendCommand(CMD_OP_MODE, [0x00]);" line238="        }" line239="    }" line240="" line241="    /**" line242="     * 送信電力設定 (0x41)" line243="     * 0.5dB/step, 0x10=8dBm, 0x14=10dBm" line244="     */" line245="    //% blockId=Set_TX_Power block=&quot;Set TX Power %txPower (dB)&quot;" line246="    //% subcategory=&quot;Other&quot; weight=95 blockGap=8" line247="    //% txPower.min=1 txPower.max=10 txPower.defl=10" line248="    export function Set_TX_Power(txPower: number): void {" line249="        if (txPower &lt; 1) txPower = 1;" line250="        if (txPower &gt; 10) txPower = 10;" line251="        " line252="        basic.showNumber(4) //0701" line253="" line254="        const reg = (txPower * 2) &amp; 0xFF;" line255="        " line256="        basic.showNumber(5) //0701" line257="" line258="        let rsp4 = sendCommand(CMD_TX_POWER, [reg]); //0701" line259="        //sendCommand(CMD_TX_POWER, [reg]);" line260="" line261="        basic.showNumber(6) //0701" line262="        basic.showNumber(rsp4[0]) //0701" line263="    }" line264="" line265="    /**" line266="     * チャネル間隔設定 (0xF0), 応答は 0xF1" line267="     */" line268="    //% blockId=Set_channel_spacing block=&quot;Set channel spacing %chSpace (kHz)&quot;" line269="    //% subcategory=&quot;Other&quot; weight=95 blockGap=8" line270="    //% chSpace.min=100 chSpace.max=200 chSpace.defl=100" line271="    export function Set_channel_spacing(chSpace: number): void {" line272="        if (chSpace &lt; 100) chSpace = 100;" line273="        if (chSpace &gt; 200) chSpace = 200;" line274="        sendCommand(CMD_CH_SPACE_SET, [chSpace &amp; 0xFF]);" line275="    }" line276="" line277="    /**" line278="     * 周波数設定 (0x40)" line279="     * 1ch:   0x40 0x00 [Freq4B]" line280="     * 2..6ch:0x40 0x01 [Freq4B] [chNum] [channelNumbers...]" line281="     */" line282="    //% blockId=Set_Frequency block=&quot;Set Frequency %frequency (Hz) %chNum (ch) %chStep&quot;" line283="    //% subcategory=&quot;Other&quot; weight=95 blockGap=8" line284="    //% frequency.min=470000000 frequency.max=928000000 frequency.defl=922080000" line285="    //% chNum.min=1 chNum.max=6 chNum.defl=2" line286="    //% chStep.min=1 chStep.max=2 chStep.defl=2" line287="    export function Set_Frequency(frequency: number, chNum: number, chStep: number): void {" line288="        // clip" line289="        if (chNum &lt; 1) chNum = 1;" line290="        if (chNum &gt; 6) chNum = 6;" line291="        if (chStep &lt; 1) chStep = 1;" line292="        if (chStep &gt; 2) chStep = 2;" line293="" line294="        // region clip（運用帯: 470–510MHz / 920–928MHz）" line295="        if (frequency &lt; 470000000) frequency = 470000000;" line296="        else if (frequency &gt; 928000000) frequency = 928000000;" line297="        else if ((frequency &gt; 510000000) &amp;&amp; (frequency &lt; 920600000)) frequency = 510000000;" line298="" line299="        const f3 = (frequency &gt;&gt;&gt; 24) &amp; 0xFF;" line300="        const f2 = (frequency &gt;&gt;&gt; 16) &amp; 0xFF;" line301="        const f1 = (frequency &gt;&gt;&gt; 8) &amp; 0xFF;" line302="        const f0 = (frequency) &amp; 0xFF;" line303="" line304="        if (chNum === 1) {" line305="            // single channel (short)" line306="            const payload2 = [SUB_SINGLE, f3, f2, f1, f0];" line307="            sendCommand(CMD_SET_TX_MODE, payload2);" line308="        } else {" line309="            // multi channel" line310="            const payload3: number[] = [SUB_MULTI, f3, f2, f1, f0, chNum];" line311="            for (let o = 0; o &lt; chNum; o++) payload3.push((o * chStep) &amp; 0xFF);" line312="            sendCommand(CMD_SET_TX_MODE, payload3);" line313="        }" line314="    }" line315="" line316="    /**" line317="     * 無線パラメータ設定 (0x42)" line318="     * 仕様上 0x01=4FSK+600sps+1/2 のみ明記。FSK8 は予約。" line319="     */" line320="    //% blockId=Set_TX_Mode block=&quot;Set TX Mode %txMode&quot;" line321="    //% subcategory=&quot;Other&quot; weight=95 blockGap=8" line322="    //% txMode.defl=Mode.FSK4" line323="    export function Set_TX_Mode(txMode: Mode): void {" line324="        if (txMode === Mode.FSK4)" line325="            sendCommand(CMD_RADIO_PARAM, [0x01]);&#9;//4FSK" line326="        else" line327="            sendCommand(CMD_RADIO_PARAM, [0x10]);&#9;//8FSK" line328="    }" line329="" line330="    // --- まとめ設定ブロック ---" line331="    /**" line332="     * ZETag の無線設定一括適用" line333="     */" line334="    //% blockId=zetag_setting" line335="    //% block=&quot;ZETag Setting|Frequency(Hz) %frequency|Band width(kHz) %chSpace|Number of Channel(ch) %chNum|Tx Power(dB) %txPower|Mode %mode&quot;" line336="    //% group=&quot;ZETag Setting&quot; weight=95 blockGap=8" line337="    //% frequency.min=470000000 frequency.max=928000000 frequency.defl=922080000" line338="    //% chSpace.min=100 chSpace.max=200 chSpace.defl=200" line339="    //% chNum.min=1 chNum.max=6 chNum.defl=2" line340="    //% txPower.min=2 txPower.max=10 txPower.defl=8" line341="    //% mode.defl=Mode.FSK4" line342="    export function applySetting(" line343="        frequency: number," line344="        chSpace: ChSpace," line345="        chNum: ChNum," line346="        txPower: TxPower," line347="        mode: Mode" line348="    ): void {" line349="        basic.showNumber(0)" line350="        // 0) 無線パラメータ（変調等）" line351="        Set_TX_Mode(mode);" line352="" line353="        basic.showNumber(1)" line354="        // 1) チャネル間隔（例: 作法として 100kHz に固定）" line355="        Set_channel_spacing(ChSpace.KHz100);" line356="" line357="        basic.showNumber(2)" line358="        // 2) 送信電力" line359="        Set_TX_Power(txPower);" line360="" line361="        basic.showNumber(3)" line362="        // 3) 周波数＋チャネル" line363="        const chStep = (chSpace === ChSpace.KHz200) ? 2 : 1;" line364="        Set_Frequency(frequency, chNum, chStep);" line365="    }" line366="}" numlines="367"></mutation></block></statement></block></xml>